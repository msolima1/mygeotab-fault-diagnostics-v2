    "index.html": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\"><title>AI Fault Diagnostics</title><style>*{box-sizing:border-box;margin:0;padding:0}body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;font-size:14px;line-height:1.5;color:#1F2937;background-color:#F9FAFB}.addin-container{max-width:1200px;margin:0 auto;padding:24px}.addin-header{margin-bottom:24px}.addin-header h1{font-size:24px;font-weight:600;color:#1F2937;margin-bottom:4px}.addin-header .subtitle{font-size:14px;color:#6B7280}.section-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}.section-header h2{font-size:18px;font-weight:600;color:#1F2937}.vehicle-section{background:#FFF;border:1px solid #E5E7EB;border-radius:8px;padding:20px;margin-bottom:24px}.vehicle-count{font-size:13px;color:#6B7280}.search-wrapper{position:relative;margin-bottom:12px}.search-wrapper input{width:100%;padding:10px 12px 10px 36px;border:1px solid #D1D5DB;border-radius:6px;font-size:14px}.search-wrapper input:focus{outline:none;border-color:#0078D3;box-shadow:0 0 0 3px rgba(0,120,211,0.1)}.search-icon{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#9CA3AF;pointer-events:none}.select-wrapper{margin-bottom:16px}.select-wrapper select{width:100%;padding:4px;border:1px solid #D1D5DB;border-radius:6px;font-size:14px;background:#FFF;cursor:pointer}.select-wrapper select:focus{outline:none;border-color:#0078D3}.date-range-wrapper{display:flex;gap:16px;margin-bottom:16px}.date-input-group{flex:1}.date-input-group label{display:block;font-size:13px;font-weight:500;color:#374151;margin-bottom:4px}.date-input-group input[type=\"date\"]{width:100%;padding:8px 12px;border:1px solid #D1D5DB;border-radius:6px;font-size:14px;color:#1F2937;background-color:white}.date-input-group input[type=\"date\"]:focus{outline:none;border-color:#0078D3;box-shadow:0 0 0 3px rgba(0,120,211,0.1)}.btn{display:inline-flex;align-items:center;justify-content:center;padding:10px 16px;border:none;border-radius:6px;font-size:14px;font-weight:500;cursor:pointer;transition:background-color 0.2s,opacity 0.2s}.btn:disabled{opacity:0.5;cursor:not-allowed}.btn-primary{background-color:#0078D3;color:#FFF}.btn-primary:hover:not(:disabled){background-color:#0066B3}.btn-icon{padding:8px;background:transparent;color:#6B7280}.btn-icon:hover{background-color:#F3F4F6;color:#1F2937}.btn-analyze{background-color:#EFF2F7;color:#0078D3;font-size:13px;padding:8px 12px}.btn-analyze:hover{background-color:#E5E9F0}.loading{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:48px;color:#6B7280}.spinner{width:32px;height:32px;border:3px solid #E5E7EB;border-top-color:#0078D3;border-radius:50%;animation:spin 1s linear infinite;margin-bottom:12px}@keyframes spin{to{transform:rotate(360deg)}}.faults-section{background:#FFF;border:1px solid #E5E7EB;border-radius:8px;padding:20px;margin-bottom:24px}.badge{display:inline-flex;align-items:center;justify-content:center;min-width:24px;height:24px;padding:0 8px;background-color:#0078D3;color:#FFF;font-size:12px;font-weight:600;border-radius:12px}.faults-list{display:flex;flex-direction:column;gap:12px}.fault-item{display:grid;grid-template-columns:auto 1fr auto;gap:16px;align-items:start;padding:16px;background:#F9FAFB;border:1px solid #E5E7EB;border-radius:8px;transition:border-color 0.2s,box-shadow 0.2s}.fault-item:hover{border-color:#0078D3;box-shadow:0 2px 8px rgba(0,120,211,0.1)}.fault-header{display:flex;flex-direction:column;align-items:center;gap:8px}.fault-code-badge{display:inline-flex;align-items:center;justify-content:center;padding:8px 12px;background:#1F2937;color:#FFF;font-family:'SF Mono',Monaco,'Courier New',monospace;font-size:13px;font-weight:600;border-radius:6px;min-width:80px}.fault-code-badge.large{font-size:16px;padding:12px 16px;min-width:100px}.severity-badge{font-size:11px;font-weight:700;text-transform:uppercase;padding:4px 10px;border-radius:12px;letter-spacing:0.5px}.severity-critical{background-color:#DC2626;color:#FFF}.severity-warning{background-color:#F59E0B;color:#FFF}.severity-medium{background-color:#FBBF24;color:#1F2937}.severity-low{background-color:#10B981;color:#FFF}.fault-details{flex:1}.fault-name{font-size:15px;font-weight:600;color:#1F2937;margin-bottom:4px}.fault-meta{font-size:13px;color:#6B7280;display:flex;align-items:center;gap:8px;margin-bottom:8px}.fault-meta .separator{color:#D1D5DB}.analysis-section{background:#FFF;border:1px solid #E5E7EB;border-radius:8px;padding:20px;margin-bottom:24px}.selected-fault-info{margin-bottom:20px}.selected-fault-card{display:flex;align-items:center;gap:16px;padding:16px;background:#F9FAFB;border-radius:8px}.selected-fault-card .fault-info h4{font-size:16px;font-weight:600;color:#1F2937}.selected-fault-card .fault-info p{font-size:13px;color:#6B7280}.ai-loading{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:48px;color:#6B7280}.ai-results{display:flex;flex-direction:column;gap:16px}.result-content{padding:16px}.comparison-table{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}.comparison-column{background:#F9FAFB;border:1px solid #E5E7EB;border-radius:8px;overflow:hidden}.column-header{display:flex;align-items:center;gap:8px;padding:12px 16px;background:#FFF;border-bottom:1px solid #E5E7EB}.column-header h4{font-size:14px;font-weight:600;color:#1F2937;margin:0}.column-icon{font-size:18px}.column-content{padding:16px;font-size:13px;line-height:1.6;color:#374151}.claude-column{border-color:#0078D3}.claude-column .column-header{background:#EFF6FF;border-bottom-color:#BFDBFE}.community-column{border-color:#F59E0B}.community-column .column-header{background:#FFFBEB;border-bottom-color:#FDE68A}.summary-list{list-style:none;padding:0;margin:0}.summary-list li{position:relative;padding:6px 0 6px 16px;border-bottom:1px solid #E5E7EB}.summary-list li:last-child{border-bottom:none}.summary-list li::before{content:'';position:absolute;left:0;top:12px;width:6px;height:6px;background:#6B7280;border-radius:50%}.claude-column .summary-list li::before{background:#0078D3}.community-column .summary-list li::before{background:#F59E0B}.source-links{display:flex;gap:12px;margin-top:16px;padding-top:12px;border-top:1px solid #E5E7EB}.source-link{display:inline-flex;align-items:center;gap:6px;padding:8px 12px;font-size:13px;font-weight:500;text-decoration:none;border-radius:6px}.youtube-link{background-color:#FEE2E2;color:#DC2626}.reddit-link{background-color:#FFF7ED;color:#EA580C}.error-message{display:flex;align-items:center;gap:12px;padding:12px 16px;background-color:#FEE2E2;border:1px solid #FECACA;border-radius:8px;color:#DC2626;margin-bottom:16px}.no-faults{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:48px;background:#FFF;border:1px solid #E5E7EB;border-radius:8px;text-align:center}.no-faults svg{margin-bottom:16px}.no-faults h3{font-size:18px;font-weight:600;color:#1F2937;margin-bottom:4px}.no-faults p{font-size:14px;color:#6B7280}.no-data{color:#9CA3AF;font-style:italic}.hidden{display:none!important}@media (max-width:768px){.addin-container{padding:16px}.fault-item{grid-template-columns:1fr;gap:12px}.comparison-table{grid-template-columns:1fr}.date-range-wrapper{flex-direction:column;gap:12px}}</style></head><body><div id=\"fault-diagnostics-addin\" class=\"addin-container\"><header class=\"addin-header\"><h1>AI Fault Diagnostics</h1><p class=\"subtitle\">Analyze vehicle fault codes with AI-powered recommendations</p></header><section id=\"vehicle-section\" class=\"vehicle-section\"><div class=\"section-header\"><h2>Select Asset</h2><span id=\"vehicle-count\" class=\"vehicle-count\"></span></div><div class=\"search-wrapper\"><input type=\"text\" id=\"vehicle-search\" placeholder=\"Search assets...\" autocomplete=\"off\"><svg class=\"search-icon\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M7 12C9.76142 12 12 9.76142 12 7C12 4.23858 9.76142 2 7 2C4.23858 2 2 4.23858 2 7C2 9.76142 4.23858 12 7 12Z\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M14 14L10.5 10.5\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg></div><div class=\"select-wrapper\"><select id=\"vehicle-select\" size=\"8\"><option value=\"\">Loading vehicles...</option></select></div><div class=\"date-range-wrapper\"><div class=\"date-input-group\"><label for=\"from-date\">From</label><input type=\"date\" id=\"from-date\"></div><div class=\"date-input-group\"><label for=\"to-date\">To</label><input type=\"date\" id=\"to-date\"></div></div><button id=\"fetch-faults-btn\" class=\"btn btn-primary\" disabled>Fetch Fault Codes</button></section><div id=\"loading\" class=\"loading hidden\"><div class=\"spinner\"></div><p>Loading...</p></div><section id=\"faults-section\" class=\"faults-section hidden\"><div class=\"section-header\"><h2>Active Fault Codes</h2><span id=\"fault-count\" class=\"badge\">0</span></div><div id=\"faults-list\" class=\"faults-list\"></div></section><section id=\"analysis-section\" class=\"analysis-section hidden\"><div class=\"section-header\"><h2>AI Diagnostic Analysis</h2><button id=\"close-analysis\" class=\"btn btn-icon\" aria-label=\"Close analysis\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\"><path d=\"M15 5L5 15M5 5L15 15\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg></button></div><div id=\"selected-fault-info\" class=\"selected-fault-info\"></div><div id=\"ai-loading\" class=\"ai-loading hidden\"><div class=\"spinner\"></div><p>Analyzing fault code with AI...</p></div><div id=\"ai-results\" class=\"ai-results hidden\"><div id=\"analysis-comparison\" class=\"result-content\"></div></div></section><div id=\"error-message\" class=\"error-message hidden\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\"><path d=\"M10 6V10M10 14H10.01M19 10C19 14.9706 14.9706 19 10 19C5.02944 19 1 14.9706 1 10C1 5.02944 5.02944 1 10 1C14.9706 1 19 5.02944 19 10Z\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span id=\"error-text\"></span></div><div id=\"no-faults\" class=\"no-faults hidden\"><svg width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" fill=\"none\"><path d=\"M24 44C35.0457 44 44 35.0457 44 24C44 12.9543 35.0457 4 24 4C12.9543 4 4 12.9543 4 24C4 35.0457 12.9543 44 24 44Z\" stroke=\"#10B981\" stroke-width=\"3\"/><path d=\"M16 24L22 30L34 18\" stroke=\"#10B981\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><h3>No Active Faults</h3><p>This vehicle has no active fault codes.</p></div></div><script>(function(){var AI_ENDPOINT='https://YOUR-CLOUD-FUNCTION-URL/analyze';var WEB_SEARCH_ENDPOINT='https://YOUR-CLOUD-FUNCTION-URL/web-search';var api,state,devices=[],currentFaults=[],selectedFault=null;var elements={};function initializeElements(){elements.vehicleSearch=document.getElementById('vehicle-search');elements.vehicleSelect=document.getElementById('vehicle-select');elements.vehicleCount=document.getElementById('vehicle-count');elements.fetchFaultsBtn=document.getElementById('fetch-faults-btn');elements.loading=document.getElementById('loading');elements.faultsSection=document.getElementById('faults-section');elements.faultsList=document.getElementById('faults-list');elements.faultCount=document.getElementById('fault-count');elements.analysisSection=document.getElementById('analysis-section');elements.closeAnalysisBtn=document.getElementById('close-analysis');elements.selectedFaultInfo=document.getElementById('selected-fault-info');elements.aiLoading=document.getElementById('ai-loading');elements.aiResults=document.getElementById('ai-results');elements.analysisComparison=document.getElementById('analysis-comparison');elements.errorMessage=document.getElementById('error-message');elements.errorText=document.getElementById('error-text');elements.noFaults=document.getElementById('no-faults');elements.fromDate=document.getElementById('from-date');elements.toDate=document.getElementById('to-date');if(elements.fromDate&&elements.toDate){var today=new Date();var thirtyDaysAgo=new Date(Date.now()-30*24*60*60*1000);elements.toDate.value=today.toISOString().split('T')[0];elements.fromDate.value=thirtyDaysAgo.toISOString().split('T')[0];}}function setupEventListeners(){elements.vehicleSearch.addEventListener('input',onVehicleSearch);elements.vehicleSelect.addEventListener('change',onVehicleChange);elements.fetchFaultsBtn.addEventListener('click',fetchFaultCodes);elements.closeAnalysisBtn.addEventListener('click',closeAnalysisPanel);}var searchTimeout=null;function onVehicleSearch(){var searchTerm=elements.vehicleSearch.value.trim();if(searchTerm.length>=2){searchDevicesAPI(searchTerm);}else if(searchTerm.length===0){loadVehicles();}else{filterVehicleDropdown(searchTerm.toLowerCase());}}function filterVehicleDropdown(searchTerm){elements.vehicleSelect.innerHTML='';var filtered=[];for(var i=0;i<devices.length;i++){var device=devices[i];var name=(device.name||device.serialNumber||device.id||'').toLowerCase();if(name.indexOf(searchTerm)!==-1){filtered.push(device);}}if(filtered.length===0){var option=document.createElement('option');option.value='';option.textContent=searchTerm?'No matching assets':'No assets found';elements.vehicleSelect.appendChild(option);}else{for(var j=0;j<filtered.length;j++){var opt=document.createElement('option');opt.value=filtered[j].id;opt.textContent=filtered[j].name||filtered[j].serialNumber||filtered[j].id;elements.vehicleSelect.appendChild(opt);}}elements.vehicleCount.textContent=searchTerm?filtered.length+' of '+devices.length+' assets':devices.length+' assets';elements.fetchFaultsBtn.disabled=true;}function loadVehicles(){showLoading(true);api.call('Get',{typeName:'Device',resultsLimit:1000},function(result){devices=result||[];populateVehicleDropdown();showLoading(false);elements.vehicleCount.textContent=devices.length+' devices';},function(error){showError('Failed to load devices: '+error);showLoading(false);});}function searchDevicesAPI(searchTerm){if(searchTimeout)clearTimeout(searchTimeout);searchTimeout=setTimeout(function(){elements.vehicleCount.textContent='Searching...';api.call('Get',{typeName:'Device',search:{name:'%'+searchTerm+'%'},resultsLimit:100},function(result){devices=result||[];filterVehicleDropdown('');elements.vehicleCount.textContent=devices.length+' matches';},function(error){elements.vehicleCount.textContent='Search failed';});},300);}function populateVehicleDropdown(){devices.sort(function(a,b){var nameA=(a.name||a.serialNumber||a.id||'').toLowerCase();var nameB=(b.name||b.serialNumber||b.id||'').toLowerCase();return nameA.localeCompare(nameB);});elements.vehicleSearch.value='';filterVehicleDropdown('');}function onVehicleChange(){var selectedId=elements.vehicleSelect.value;elements.fetchFaultsBtn.disabled=!selectedId;hideElement(elements.faultsSection);hideElement(elements.analysisSection);hideElement(elements.noFaults);hideElement(elements.errorMessage);}function fetchFaultCodes(){var deviceId=elements.vehicleSelect.value;if(!deviceId){showError('Please select a vehicle');return;}showLoading(true);hideElement(elements.faultsSection);hideElement(elements.noFaults);hideElement(elements.analysisSection);var fromDate,toDate;if(elements.fromDate&&elements.fromDate.value){fromDate=new Date(elements.fromDate.value).toISOString();}else{fromDate=new Date(Date.now()-30*24*60*60*1000).toISOString();}if(elements.toDate&&elements.toDate.value){var endDate=new Date(elements.toDate.value);endDate.setHours(23,59,59,999);toDate=endDate.toISOString();}else{toDate=new Date().toISOString();}api.call('Get',{typeName:'FaultData',search:{deviceSearch:{id:deviceId},fromDate:fromDate,toDate:toDate},resultsLimit:100},function(faultDataResult){showLoading(false);currentFaults=faultDataResult||[];if(currentFaults.length===0){showElement(elements.noFaults);}else{fetchDiagnosticDetails(currentFaults);}},function(error){showLoading(false);showError('Failed to fetch fault codes: '+error);});}function fetchDiagnosticDetails(faults){var diagnosticIds=[];var seen={};for(var i=0;i<faults.length;i++){var f=faults[i];if(f.diagnostic&&f.diagnostic.id&&!seen[f.diagnostic.id]){seen[f.diagnostic.id]=true;diagnosticIds.push(f.diagnostic.id);}}if(diagnosticIds.length===0){displayFaults(faults,{});return;}var calls=[];for(var j=0;j<diagnosticIds.length;j++){calls.push(['Get',{typeName:'Diagnostic',search:{id:diagnosticIds[j]}}]);}api.multiCall(calls,function(results){var diagnosticsMap={};for(var k=0;k<results.length;k++){if(results[k]&&results[k].length>0){diagnosticsMap[diagnosticIds[k]]=results[k][0];}}displayFaults(faults,diagnosticsMap);},function(error){displayFaults(faults,{});});}function displayFaults(faults,diagnosticsMap){elements.faultsList.innerHTML='';elements.faultCount.textContent=faults.length;var groupedFaults={};for(var i=0;i<faults.length;i++){var fault=faults[i];var diagId=fault.diagnostic?fault.diagnostic.id:'unknown';if(!groupedFaults[diagId]){groupedFaults[diagId]={faults:[],diagnostic:diagnosticsMap[diagId]||null};}groupedFaults[diagId].faults.push(fault);}var keys=Object.keys(groupedFaults);for(var j=0;j<keys.length;j++){var diagId=keys[j];var group=groupedFaults[diagId];var latestFault=group.faults[0];var diagnostic=group.diagnostic;var faultItem=createFaultItem(latestFault,diagnostic,group.faults.length);elements.faultsList.appendChild(faultItem);}showElement(elements.faultsSection);}function createFaultItem(fault,diagnostic,occurrences){var item=document.createElement('div');item.className='fault-item';var severityClass='severity-low';var severityText='Low';if(fault.redStopLamp){severityClass='severity-critical';severityText='Critical';}else if(fault.amberWarningLamp){severityClass='severity-warning';severityText='Warning';}else if(fault.malfunctionLamp){severityClass='severity-medium';severityText='Medium';}var faultCode=getFaultCode(fault,diagnostic);var faultName=diagnostic?diagnostic.name:'Unknown Fault';var faultDate=new Date(fault.dateTime).toLocaleString();item.innerHTML='<div class=\"fault-header\"><div class=\"fault-code-badge\">'+faultCode+'</div><span class=\"severity-badge '+severityClass+'\">'+severityText+'</span></div><div class=\"fault-details\"><h4 class=\"fault-name\">'+faultName+'</h4><p class=\"fault-meta\"><span class=\"occurrences\">'+occurrences+' occurrence'+(occurrences>1?'s':'')+'</span><span class=\"separator\">|</span><span class=\"date\">Last: '+faultDate+'</span></p></div><button class=\"btn btn-analyze\">Analyze with AI</button>';item.faultData={fault:fault,diagnostic:diagnostic,faultCode:faultCode,faultName:faultName,occurrences:occurrences};var analyzeBtn=item.querySelector('.btn-analyze');analyzeBtn.addEventListener('click',function(){analyzeFaultWithAI(item.faultData);});return item;}function getFaultCode(fault,diagnostic){if(!diagnostic)return'Unknown';var source='';if(diagnostic.source){source=typeof diagnostic.source==='string'?diagnostic.source:(diagnostic.source.id||'');}var code=diagnostic.code;if(source.indexOf('Obd')!==-1||source.indexOf('OBD')!==-1){var prefix='P';if(fault.controller){var controllerId=typeof fault.controller==='string'?fault.controller:(fault.controller.id||'');if(controllerId.indexOf('Body')!==-1)prefix='B';else if(controllerId.indexOf('Chassis')!==-1)prefix='C';else if(controllerId.indexOf('Network')!==-1)prefix='U';}var hexCode=code.toString(16).toUpperCase();while(hexCode.length<4)hexCode='0'+hexCode;return prefix+hexCode;}if(source.indexOf('J1939')!==-1){var spn=code;var fmi='';if(fault.failureMode&&typeof fault.failureMode==='object'){fmi=fault.failureMode.code||'';}return fmi?'SPN '+spn+' / FMI '+fmi:'SPN '+spn;}if(code&&code>0){var hexCode=code.toString(16).toUpperCase();while(hexCode.length<4)hexCode='0'+hexCode;return'P'+hexCode;}return'Code '+code;}function analyzeFaultWithAI(faultData){selectedFault=faultData;showElement(elements.analysisSection);showElement(elements.aiLoading);hideElement(elements.aiResults);elements.selectedFaultInfo.innerHTML='<div class=\"selected-fault-card\"><span class=\"fault-code-badge large\">'+faultData.faultCode+'</span><div class=\"fault-info\"><h4>'+faultData.faultName+'</h4><p>'+faultData.occurrences+' occurrence'+(faultData.occurrences>1?'s':'')+'</p></div></div>';var prompt=buildClaudePrompt(faultData);Promise.all([callClaudeAPI(prompt),callWebSearchAPI(faultData.faultCode,faultData.faultName)]).then(function(results){hideElement(elements.aiLoading);displayComparisonResults(results[0],results[1]);}).catch(function(error){hideElement(elements.aiLoading);showError('Analysis failed: '+error.message);});}function buildClaudePrompt(faultData){var fault=faultData.fault;var diagnostic=faultData.diagnostic;var context='You are an expert vehicle diagnostic technician. Analyze the following fault code.\\n\\nFAULT CODE: '+faultData.faultCode+'\\nFAULT NAME: '+faultData.faultName+'\\nOCCURRENCES: '+faultData.occurrences;if(fault.redStopLamp)context+='\\nSEVERITY: CRITICAL';else if(fault.amberWarningLamp)context+='\\nSEVERITY: WARNING';context+='\\n\\nProvide analysis as JSON: {\"recommendedActions\":[\"action1\",\"action2\"],\"actionsToTake\":[{\"priority\":\"immediate\",\"action\":\"desc\"}]}';return context;}function callClaudeAPI(prompt){return fetch(AI_ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({prompt:prompt})}).then(function(response){if(!response.ok)throw new Error('API failed');return response.json();}).then(function(data){if(data.error)throw new Error(data.error);if(data.choices&&data.choices[0]&&data.choices[0].message){return parseClaudeResponse(data.choices[0].message.content);}throw new Error('Invalid response');});}function callWebSearchAPI(faultCode,faultName){return fetch(WEB_SEARCH_ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({faultCode:faultCode,faultName:faultName})}).then(function(response){if(!response.ok)throw new Error('Search failed');return response.json();}).then(function(data){if(data.choices&&data.choices[0]&&data.choices[0].message){return{content:data.choices[0].message.content};}return{content:'No insights available.'};}).catch(function(error){return{content:'Unable to fetch insights.'};});}function parseClaudeResponse(responseText){try{var jsonStr=responseText;var jsonMatch=responseText.match(/```(?:json)?([\\s\\S]*?)```/);if(jsonMatch)jsonStr=jsonMatch[1];var analysis=JSON.parse(jsonStr);return{parsed:true,data:analysis,raw:responseText};}catch(e){return{parsed:false,data:null,raw:responseText};}}function displayComparisonResults(claudeResult,webSearchResult){var faultCode=selectedFault?selectedFault.faultCode:'';var faultName=selectedFault?selectedFault.faultName:'';var searchQuery=encodeURIComponent(faultCode+' '+faultName+' fix');var claudeSummary='';if(claudeResult.parsed&&claudeResult.data){var analysis=claudeResult.data;var items=[];if(analysis.recommendedActions){for(var i=0;i<Math.min(analysis.recommendedActions.length,3);i++){items.push(analysis.recommendedActions[i]);}}if(items.length>0){claudeSummary='<ul class=\"summary-list\">';for(var j=0;j<items.length;j++){claudeSummary+='<li>'+items[j]+'</li>';}claudeSummary+='</ul>';}else{claudeSummary=claudeResult.raw.replace(/\\n/g,'<br>');}}else{claudeSummary=claudeResult.raw.replace(/\\n/g,'<br>');}var webSummary=webSearchResult.content.replace(/\\n/g,'<br>');var sourceLinks='<div class=\"source-links\"><a href=\"https://www.youtube.com/results?search_query='+searchQuery+'\" target=\"_blank\" class=\"source-link youtube-link\">Search YouTube</a><a href=\"https://www.reddit.com/search/?q='+searchQuery+'\" target=\"_blank\" class=\"source-link reddit-link\">Search Reddit</a></div>';elements.analysisComparison.innerHTML='<div class=\"comparison-table\"><div class=\"comparison-column claude-column\"><div class=\"column-header\"><span class=\"column-icon\">AI</span><h4>Claude Analysis</h4></div><div class=\"column-content\">'+claudeSummary+'</div></div><div class=\"comparison-column community-column\"><div class=\"column-header\"><span class=\"column-icon\">Web</span><h4>Community Insights</h4></div><div class=\"column-content\">'+webSummary+sourceLinks+'</div></div></div>';showElement(elements.aiResults);}function closeAnalysisPanel(){hideElement(elements.analysisSection);selectedFault=null;}function showLoading(show){if(show){showElement(elements.loading);}else{hideElement(elements.loading);}}function showError(message){elements.errorText.textContent=message;showElement(elements.errorMessage);setTimeout(function(){hideElement(elements.errorMessage);},5000);}function showElement(el){el.classList.remove('hidden');}function hideElement(el){el.classList.add('hidden');}geotab.addin.aiFaultDiagnostics=function(){return{initialize:function(freshApi,freshState,cb){api=freshApi;state=freshState;initializeElements();setupEventListeners();cb();},focus:function(freshApi,freshState){api=freshApi;state=freshState;loadVehicles();},blur:function(){currentFaults=[];selectedFault=null;}};};})();</script></body></html>"
  }
